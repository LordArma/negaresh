#. Description of the plugin
#: negaresh.php
msgid "Negaresh tries to fix your Farsi (Persian) typos in WordPress."
msgstr "نگارش تلاش می‌کند غلط‌های نگارشی فارسی را در وردپرس اصلاح کند."

#. Author of the plugin
#: negaresh.php
msgid "Lord Arma"
msgstr "Lord Arma"

#. Author URI of the plugin
#: negaresh.php
msgid "https://LordArma.com/"
msgstr "https://LordArma.com/"

#: includes/negaresh-bulk-page.php:66
#: includes/negaresh-bulk-page.php:300
msgid "Negaresh: fix existing posts"
msgstr "نگارش: اصلاح نوشته‌های موجود"

#: includes/negaresh-bulk-page.php:101
msgid "Number of items per page:"
msgstr "تعداد موارد در هر برگه:"

#: includes/negaresh-bulk-page.php:265
msgid "Checking…"
msgstr "در حال بررسی…"

#: includes/negaresh-bulk-page.php:266
msgid "Already correct: fixing only marks it as checked."
msgstr "درست است: اصلاح فقط آن را بررسی‌شده علامت می‌زند."

#: includes/negaresh-bulk-page.php:267
msgid "Nothing to change."
msgstr "چیزی برای تغییر نیست."

#. translators: %d: changed lines.
#: includes/negaresh-bulk-page.php:269
#, php-format
msgid "Show changes (%d lines)"
msgstr "نمایش تغییرها (%d خط)"

#. translators: %s: error message.
#: includes/negaresh-bulk-page.php:271
#, php-format
msgid "Could not be checked: %s"
msgstr "بررسی نشد: %s"

#: includes/negaresh-bulk-page.php:272
msgid "You may not edit this post."
msgstr "اجازهٔ ویرایش این نوشته را ندارید."

#. translators: 1: posts done so far, 2: posts to fix.
#: includes/negaresh-bulk-page.php:274
#, php-format
msgid "Fixing posts: %1$d of %2$d"
msgstr "اصلاح نوشته‌ها: %1$d از %2$d"

#. translators: %d: posts to fix.
#: includes/negaresh-bulk-page.php:276
#, php-format
msgid "Fix the selected posts (%d)? This changes the stored posts; each one can be restored from its revisions."
msgstr "نوشته‌های برگزیده (%d) اصلاح شوند؟ متن ذخیره‌شده تغییر می‌کند؛ هر نوشته را می‌توان از نسخه‌های پیشینش بازگرداند."

#. translators: %d: posts to fix.
#: includes/negaresh-bulk-page.php:278
#, php-format
msgid "Fix every waiting post (%d)? This changes the stored posts; each one can be restored from its revisions."
msgstr "همهٔ نوشته‌های در انتظار (%d) اصلاح شوند؟ متن ذخیره‌شده تغییر می‌کند؛ هر نوشته را می‌توان از نسخه‌های پیشینش بازگرداند."

#: includes/negaresh-bulk-page.php:279
msgid "Select at least one post."
msgstr "دست‌کم یک نوشته را برگزینید."

#: includes/negaresh-bulk-page.php:280
msgid "No posts are waiting."
msgstr "هیچ نوشته‌ای در انتظار نیست."

#: includes/negaresh-bulk-page.php:281
msgid "Something went wrong; the list shows what was done."
msgstr "مشکلی پیش آمد؛ فهرست نشان می‌دهد چه کاری انجام شده است."

#. translators: %s: number of posts waiting.
#: includes/negaresh-bulk-page.php:306
#, php-format
msgid "Fix all waiting posts (%s)"
msgstr "اصلاح همهٔ نوشته‌های در انتظار (%s)"

#: includes/negaresh-bulk-page.php:313
msgid "Posts are checked with the saved rules."
msgstr "نوشته‌ها با قاعده‌های ذخیره‌شده بررسی می‌شوند."

#: includes/negaresh-bulk-page.php:314
msgid "The Changes column shows what fixing would change; nothing is saved until you fix."
msgstr "ستون «تغییرها» نشان می‌دهد اصلاح چه چیزی را تغییر می‌دهد؛ تا اصلاح نکنید چیزی ذخیره نمی‌شود."

#: includes/negaresh-bulk-page.php:315
msgid "Posts marked “Leave this post alone” are never touched."
msgstr "به نوشته‌هایی که «این نوشته را تغییر نده» دارند هرگز دست زده نمی‌شود."

#: includes/negaresh-bulk-page.php:322
msgid "Search posts"
msgstr "جست‌وجوی نوشته‌ها"

#. translators: %s: number of posts.
#: includes/negaresh-bulk-page.php:344
#, php-format
msgid "Posts fixed: %s."
msgstr "نوشته‌های اصلاح‌شده: %s."

#. translators: %s: number of posts.
#: includes/negaresh-bulk-page.php:346
#, php-format
msgid "Posts already correct, now marked as checked: %s."
msgstr "نوشته‌هایی که درست بودند و اکنون بررسی‌شده علامت خوردند: %s."

#: includes/negaresh-bulk-page.php:349
msgid "The text before each change is kept in the post's revisions."
msgstr "متن پیش از هر تغییر در نسخه‌های نوشته نگه داشته می‌شود."

#. translators: %s: number of posts.
#: includes/negaresh-bulk-page.php:353
#, php-format
msgid "Posts that could not be fixed: %s."
msgstr "نوشته‌هایی که اصلاح نشدند: %s."

#: includes/negaresh-bulk-table.php:120
msgid "Title"
msgstr "عنوان"

#: includes/negaresh-bulk-table.php:121
msgid "Type"
msgstr "نوع"

#: includes/negaresh-bulk-table.php:122
msgid "Status"
msgstr "وضعیت"

#: includes/negaresh-bulk-table.php:123
msgid "Changes"
msgstr "تغییرها"

#: includes/negaresh-bulk-table.php:124
msgid "Date"
msgstr "تاریخ"

#: includes/negaresh-bulk-table.php:145
msgid "Fix"
msgstr "اصلاح"

#: includes/negaresh-bulk-table.php:154
#: includes/negaresh-bulk-table.php:294
msgid "Waiting"
msgstr "در انتظار"

#: includes/negaresh-bulk-table.php:155
#: includes/negaresh-bulk-table.php:295
msgid "Fixed"
msgstr "اصلاح‌شده"

#: includes/negaresh-bulk-table.php:156
#: includes/negaresh-bulk-table.php:296
msgid "Left alone"
msgstr "بدون تغییر"

#: includes/negaresh-bulk-table.php:157
msgid "All"
msgstr "همه"

#: includes/negaresh-bulk-table.php:188
msgid "Filter by post type"
msgstr "صافی بر پایهٔ نوع نوشته"

#: includes/negaresh-bulk-table.php:189
msgid "All post types"
msgstr "همهٔ نوع‌های نوشته"

#: includes/negaresh-bulk-table.php:200
msgid "Filter"
msgstr "صافی"

#: includes/negaresh-bulk-table.php:207
msgid "No posts are waiting: every post is checked with the current rules."
msgstr "هیچ نوشته‌ای در انتظار نیست: همهٔ نوشته‌ها با قاعده‌های کنونی بررسی شده‌اند."

#: includes/negaresh-bulk-table.php:209
msgid "No posts found."
msgstr "نوشته‌ای پیدا نشد."

#. translators: %s: post title.
#: includes/negaresh-bulk-table.php:225
#, php-format
msgid "Select %s"
msgstr "گزینش %s"

#: includes/negaresh-bulk-table.php:262
msgid "Edit"
msgstr "ویرایش"

#: includes/negaresh-bulk-table.php:266
msgid "View"
msgstr "نمایش"

#: includes/negaresh-bulk-table.php:273
msgid "Fix now"
msgstr "اصلاح کن"

#. translators: %d: post ID, shown for posts without a title.
#: includes/negaresh-bulk-table.php:349
#, php-format
msgid "(no title) #%d"
msgstr "(بدون عنوان) #%d"

#: includes/negaresh-dashboard.php:83
msgid "Fixing text when a post is saved."
msgstr "متن هنگام ذخیرهٔ نوشته اصلاح می‌شود."

#: includes/negaresh-dashboard.php:84
msgid "Fixing text when a post is displayed."
msgstr "متن هنگام نمایش نوشته اصلاح می‌شود."

#: includes/negaresh-dashboard.php:86
msgid "Fixed with the current rules"
msgstr "اصلاح‌شده با قاعده‌های کنونی"

#: includes/negaresh-dashboard.php:87
msgid "Waiting to be checked"
msgstr "در انتظار بررسی"

#: includes/negaresh-dashboard.php:88
msgid "Left alone (opted out)"
msgstr "بدون تغییر (به خواست نویسنده)"

#: includes/negaresh-dashboard.php:100
#: includes/negaresh-dashboard.php:133
#: includes/negaresh-settings.php:820
msgid "Fix existing posts"
msgstr "اصلاح نوشته‌های موجود"

#: includes/negaresh-dashboard.php:106
#: includes/negaresh-settings.php:815
msgid "Settings"
msgstr "تنظیمات"

#. translators: %d: posts not yet checked with the current rules.
#: includes/negaresh-dashboard.php:129
#, php-format
msgid "Negaresh: posts not yet checked with the current rules: %d. You can see what would change and fix them in Tools → Negaresh."
msgstr "نگارش: نوشته‌هایی که هنوز با قاعده‌های کنونی بررسی نشده‌اند: %d. در «ابزارها ← نگارش» می‌توانید ببینید چه چیزی تغییر می‌کند و اصلاحشان کنید."

#: includes/negaresh-dashboard.php:135
msgid "Dismiss"
msgstr "بستن"

#: includes/negaresh-editor.php:73
#: includes/negaresh-editor.php:180
msgid "Leave this post alone (do not fix its text)"
msgstr "این نوشته را تغییر نده (متن آن اصلاح نشود)"

#: includes/negaresh-editor.php:181
msgid "Fix this post now"
msgstr "همین حالا این نوشته را اصلاح کن"

#: includes/negaresh-editor.php:182
msgid "Fixes the text in the editor with the saved rules. Undo reverts it."
msgstr "متن ویرایشگر را با قاعده‌های ذخیره‌شده اصلاح می‌کند. با «واگرد» برمی‌گردد."

#: includes/negaresh-editor.php:183
msgid "Nothing to fix."
msgstr "چیزی برای اصلاح نیست."

#: includes/negaresh-editor.php:184
msgid "Text fixed. Use Undo to revert."
msgstr "متن اصلاح شد. برای برگرداندن از «واگرد» استفاده کنید."

#: includes/negaresh-editor.php:185
msgid "The text could not be fixed."
msgstr "متن اصلاح نشد."

#: includes/negaresh-settings.php:419
msgid "Sorry, you are not allowed to do that."
msgstr "متأسفانه اجازهٔ این کار را ندارید."

#: includes/negaresh-settings.php:443
#: includes/negaresh-settings.php:459
msgid "Negaresh network defaults"
msgstr "پیش‌فرض‌های شبکه برای نگارش"

#: includes/negaresh-settings.php:461
msgid "Network defaults saved."
msgstr "پیش‌فرض‌های شبکه ذخیره شد."

#: includes/negaresh-settings.php:463
msgid "Every site that has not saved its own Negaresh settings uses these, including new sites."
msgstr "هر سایتی که تنظیمات نگارش خودش را ذخیره نکرده از این‌ها استفاده می‌کند، از جمله سایت‌های تازه."

#: includes/negaresh-settings.php:500
#: includes/negaresh-settings.php:763
msgid "Negaresh Options"
msgstr "تنظیمات نگارش"

#: includes/negaresh-settings.php:522
msgid "When to fix"
msgstr "زمان اصلاح"

#: includes/negaresh-settings.php:525
msgid "Words and phrases"
msgstr "واژه‌ها و عبارت‌ها"

#: includes/negaresh-settings.php:543
msgid "Post types"
msgstr "نوع‌های نوشته"

#: includes/negaresh-settings.php:545
msgid "Fix post titles"
msgstr "اصلاح عنوان نوشته‌ها"

#: includes/negaresh-settings.php:546
msgid "Fix excerpts written by hand"
msgstr "اصلاح خلاصه‌هایی که دستی نوشته شده‌اند"

#: includes/negaresh-settings.php:547
msgid "Fix comments"
msgstr "اصلاح دیدگاه‌ها"

#: includes/negaresh-settings.php:548
msgid "Fix text in RSS feeds"
msgstr "اصلاح متن در خوراک‌های RSS"

#: includes/negaresh-settings.php:549
msgid "Fix text in the REST API"
msgstr "اصلاح متن در REST API"

#: includes/negaresh-settings.php:569
msgid "Mode"
msgstr "حالت"

#: includes/negaresh-settings.php:570
msgid "Letters and numbers"
msgstr "حروف و اعداد"

#: includes/negaresh-settings.php:571
msgid "Punctuation"
msgstr "نشانه‌گذاری"

#: includes/negaresh-settings.php:572
msgid "Spacing and half spaces"
msgstr "فاصله و نیم‌فاصله"

#: includes/negaresh-settings.php:573
msgid "Cleanup"
msgstr "پاک‌سازی"

#: includes/negaresh-settings.php:574
msgid "Where to apply"
msgstr "محدودهٔ اعمال"

#: includes/negaresh-settings.php:575
msgid "Words to leave alone"
msgstr "واژه‌هایی که تغییر نمی‌کنند"

#: includes/negaresh-settings.php:590
msgid "Convert presentation form glyphs to standard Persian letters"
msgstr "تبدیل شکل‌های نمایشی حروف به حروف استاندارد فارسی"

#: includes/negaresh-settings.php:595
msgid "Convert Arabic digits to Persian digits"
msgstr "تبدیل ارقام عربی به ارقام فارسی"

#: includes/negaresh-settings.php:600
msgid "Convert English digits to Persian digits"
msgstr "تبدیل ارقام انگلیسی به ارقام فارسی"

#: includes/negaresh-settings.php:605
msgid "Use Persian percent, decimal and thousands separators"
msgstr "استفاده از علامت درصد، ممیز و جداکنندهٔ هزارگان فارسی"

#: includes/negaresh-settings.php:610
msgid "Replace Arabic Kaf, Yeh and Heh with Persian letters"
msgstr "جایگزینی کاف، یا و های عربی با حروف فارسی"

#: includes/negaresh-settings.php:615
msgid "Write the ezafe after a final Heh as Hamzeh"
msgstr "نوشتن کسرهٔ اضافه پس از های پایانی به‌صورت همزه"

#: includes/negaresh-settings.php:620
msgid "Convert Arabic Teh Marbuta to Heh with Hamzeh (needs the Hamzeh rule)"
msgstr "تبدیل تای گرد عربی به «هٔ» (نیازمند قاعدهٔ همزه)"

#: includes/negaresh-settings.php:625
msgid "Clean up spaces and repeats around diacritics"
msgstr "پاک‌سازی فاصله‌ها و تکرارها در کنار اعراب"

#: includes/negaresh-settings.php:630
msgid "Remove all diacritics"
msgstr "حذف همهٔ اعراب"

#: includes/negaresh-settings.php:635
msgid "Convert double and triple hyphens to en and em dashes"
msgstr "تبدیل دو و سه خط فاصله به خط تیرهٔ کوتاه و بلند"

#: includes/negaresh-settings.php:640
msgid "Convert three dots to an ellipsis character"
msgstr "تبدیل سه نقطه به نویسهٔ سه‌نقطه"

#: includes/negaresh-settings.php:645
msgid "Merge repeated ellipses and put one space after them"
msgstr "یکی کردن سه‌نقطه‌های پشت سر هم و گذاشتن یک فاصله پس از آن"

#: includes/negaresh-settings.php:650
msgid "Remove the space before an ellipsis"
msgstr "حذف فاصلهٔ پیش از سه‌نقطه"

#: includes/negaresh-settings.php:655
msgid "Replace curly English quotes with Persian guillemets"
msgstr "جایگزینی گیومهٔ خمیدهٔ انگلیسی با گیومهٔ فارسی"

#: includes/negaresh-settings.php:660
msgid "Replace straight quotes with Persian guillemets"
msgstr "جایگزینی نقل‌قول ساده با گیومهٔ فارسی"

#: includes/negaresh-settings.php:665
msgid "Use the Persian comma and semicolon"
msgstr "استفاده از ویرگول و نقطه‌ویرگول فارسی"

#: includes/negaresh-settings.php:670
msgid "Use the Persian question mark"
msgstr "استفاده از علامت سؤال فارسی"

#: includes/negaresh-settings.php:675
msgid "Merge repeated question and exclamation marks"
msgstr "یکی کردن علامت‌های سؤال و تعجب تکراری"

#: includes/negaresh-settings.php:680
msgid "Treat a Kashida next to a space as a dash"
msgstr "تبدیل کشیدهٔ کنار فاصله به خط تیره"

#: includes/negaresh-settings.php:685
msgid "Reorder dates written with slashes to year/month/day"
msgstr "مرتب کردن تاریخ‌های اسلش‌دار به ترتیب سال/ماه/روز"

#: includes/negaresh-settings.php:690
msgid "Join the prefixes می, نمی and بی with a half space"
msgstr "چسباندن پیشوندهای «می»، «نمی» و «بی» با نیم‌فاصله"

#: includes/negaresh-settings.php:695
msgid "Join common suffixes with a half space"
msgstr "چسباندن پسوندهای رایج با نیم‌فاصله"

#: includes/negaresh-settings.php:700
msgid "Fix the ای suffix after a final Heh"
msgstr "اصلاح پسوند «ای» پس از های پایانی"

#: includes/negaresh-settings.php:705
msgid "Fix spaces inside and around brackets and quotes"
msgstr "اصلاح فاصله‌ها درون و پیرامون پرانتزها و گیومه‌ها"

#: includes/negaresh-settings.php:710
msgid "Remove the space before punctuation and keep one after it"
msgstr "حذف فاصلهٔ پیش از نشانه‌ها و گذاشتن یک فاصله پس از آن‌ها"

#: includes/negaresh-settings.php:715
msgid "Remove the space before honorifics and numbered references"
msgstr "حذف فاصلهٔ پیش از نشانه‌های احترام و ارجاع‌های شماره‌دار"

#: includes/negaresh-settings.php:720
msgid "Replace repeated spaces with one space"
msgstr "جایگزینی فاصله‌های تکراری با یک فاصله"

#: includes/negaresh-settings.php:725
msgid "Remove extra or misplaced half spaces"
msgstr "حذف نیم‌فاصله‌های اضافه یا نابه‌جا"

#: includes/negaresh-settings.php:730
msgid "Replace right to left marks between letters with half spaces"
msgstr "جایگزینی نشانهٔ راست‌به‌چپ (RLM) میان حروف با نیم‌فاصله"

#: includes/negaresh-settings.php:735
msgid "Remove Kashidas inside words"
msgstr "حذف کشیده درون واژه‌ها"

#: includes/negaresh-settings.php:740
msgid "Use Unix line endings"
msgstr "استفاده از پایان خط یونیکس"

#: includes/negaresh-settings.php:745
msgid "Reduce more than two line breaks to two"
msgstr "کاهش بیش از دو شکست خط پیاپی به دو"

#: includes/negaresh-settings.php:750
msgid "Trim spaces at the start of lines and of the text"
msgstr "حذف فاصله‌ها از آغاز خط‌ها و آغاز و پایان متن"

#: includes/negaresh-settings.php:766
msgid "Try it"
msgstr "امتحان کنید"

#: includes/negaresh-settings.php:769
msgid "Type or paste some text (HTML is fine). The result uses the boxes as they are checked on this page, before you save."
msgstr "متنی بنویسید یا بچسبانید (HTML هم پذیرفته است). نتیجه بر پایهٔ گزینه‌هایی است که همین حالا در این صفحه انتخاب شده‌اند، پیش از ذخیره."

#: includes/negaresh-settings.php:775
msgid "Text to fix"
msgstr "متن برای اصلاح"

#: includes/negaresh-settings.php:777
msgid "Result"
msgstr "نتیجه"

#: includes/negaresh-settings.php:791
msgid "Reset rules to defaults"
msgstr "بازگرداندن قاعده‌ها به پیش‌فرض"

#: includes/negaresh-settings.php:841
msgid "Working…"
msgstr "در حال کار…"

#: includes/negaresh-settings.php:842
msgid "The preview could not be made."
msgstr "پیش‌نمایش ساخته نشد."

#: includes/negaresh-settings.php:843
msgid "Set every rule back to its default? Unsaved changes to the rules are lost."
msgstr "همهٔ قاعده‌ها به حالت پیش‌فرض برگردند؟ تغییرهای ذخیره‌نشدهٔ قاعده‌ها از دست می‌روند."

#: includes/negaresh-settings.php:871
msgid "When a post is saved: the stored text is corrected, so what you see in the editor is what readers get"
msgstr "هنگام ذخیرهٔ نوشته: متن ذخیره‌شده اصلاح می‌شود، پس آنچه در ویرایشگر می‌بینید همان است که خوانندگان می‌بینند"

#: includes/negaresh-settings.php:875
msgid "When a post is displayed: the stored text is never changed"
msgstr "هنگام نمایش نوشته: متن ذخیره‌شده هرگز تغییر نمی‌کند"

#: includes/negaresh-settings.php:888
msgid "Saving changes your posts and cannot be undone. Posts saved before are still fixed on display until they are saved again."
msgstr "اصلاح هنگام ذخیره نوشته‌ها را تغییر می‌دهد و برگشت‌پذیر نیست. نوشته‌هایی که پیش‌تر ذخیره شده‌اند تا ذخیرهٔ دوباره، هنگام نمایش اصلاح می‌شوند."

#: includes/negaresh-settings.php:904
msgid "One word or phrase per line. Only whole words match."
msgstr "هر خط یک واژه یا عبارت. فقط واژه‌های کامل پیدا می‌شوند."

#: includes/negaresh-settings.php:905
msgid "Negaresh never changes them: for example brand names, names spelled in a special way, or quotations."
msgstr "نگارش هرگز آن‌ها را تغییر نمی‌دهد: مانند نام تجاری، نام‌هایی که به شکل ویژه نوشته می‌شوند یا نقل‌قول‌ها."

#: includes/negaresh-settings.php:922
msgid "Leave all unchecked to fix every post type."
msgstr "برای اصلاح همهٔ نوع‌ها، هیچ‌کدام را انتخاب نکنید."
